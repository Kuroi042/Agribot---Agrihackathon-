MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=agribot/inverter/telemetry
MQTT_COMMAND_TOPIC=agribot/inverter/command
MIN_CURRENT_A=2
MAX_CURRENT_A=40
MIN_SOLAR_VOLTAGE_V=500
